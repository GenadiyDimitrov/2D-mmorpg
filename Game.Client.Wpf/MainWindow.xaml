<Window x:Class="Game.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L2-like — Phase 4"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#FF101418">
    <Grid>

        <Canvas x:Name="WorldCanvas"
                Background="#FF15201A"
                ClipToBounds="True"
                MouseLeftButtonDown="WorldCanvas_MouseLeftButtonDown"/>

        <TextBlock x:Name="StatusText"
                   Margin="12,8,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Foreground="#FFB9C4CC" FontFamily="Consolas" FontSize="13"
                   Text="Not connected"/>

        <!-- Top-right buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,12,0">
            <Button x:Name="InventoryButton" Content="Inventory (I)" Width="110" Height="28"
                    Margin="0,0,6,0" Click="InventoryButton_Click" Visibility="Collapsed"/>
            <Button x:Name="ClassButton" Content="Class" Width="70" Height="28"
                    Click="ClassButton_Click" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Target frame -->
        <Border x:Name="TargetFrame"
                Width="240"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,10,0,0" Padding="10,6"
                Background="#A0000000" CornerRadius="6"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TargetNameText"
                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <Border Background="#60000000" Height="9" Margin="0,5,0,4" CornerRadius="2">
                    <Rectangle x:Name="TargetHpFill" Fill="#FFCC3333"
                               HorizontalAlignment="Left" Width="218"/>
                </Border>
                <Button x:Name="TradeButton" Content="Request Trade" Height="24"
                        Click="TradeButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <StackPanel x:Name="SkillBar"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Visibility="Collapsed"/>

        <Border x:Name="CastBar"
                Width="230" Height="18"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,58"
                Background="#90000000" CornerRadius="4"
                Visibility="Collapsed">
            <Grid>
                <Rectangle x:Name="CastFill" Fill="#FF4488DD"
                           HorizontalAlignment="Left" Width="0" RadiusX="3" RadiusY="3"/>
                <TextBlock x:Name="CastText" Foreground="White" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Chat -->
        <Border x:Name="ChatPanel"
                Width="460" Height="320"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="10" Padding="6"
                Background="#A0000000" CornerRadius="6"
                Visibility="Collapsed">
            <DockPanel>
                <TextBox x:Name="ChatInput" DockPanel.Dock="Bottom"
                         Height="26" Margin="0,6,0,0"
                         Background="#60000000" Foreground="White"
                         BorderBrush="#FF445566" CaretBrush="White"
                         KeyDown="ChatInput_KeyDown"/>
                <Border DockPanel.Dock="Top" Height="62" Margin="0,0,0,4"
                        Background="#40000000" CornerRadius="4" Padding="4">
                    <ScrollViewer x:Name="SystemScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SystemList"/>
                    </ScrollViewer>
                </Border>
                <TabControl x:Name="ChatTabs" Background="Transparent" BorderThickness="0" Padding="2">
                    <TabItem Header="All">
                        <ScrollViewer x:Name="AllScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AllList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="World">
                        <ScrollViewer x:Name="WorldScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WorldList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Local">
                        <ScrollViewer x:Name="LocalScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LocalList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Whisper">
                        <DockPanel>
                            <ComboBox x:Name="WhisperNames" DockPanel.Dock="Top" Height="24"
                                      Margin="0,2,0,4" SelectionChanged="WhisperNames_SelectionChanged"/>
                            <ScrollViewer x:Name="WhisperScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="WhisperList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- Inventory panel -->
        <Border x:Name="InventoryPanel"
                Width="300" Height="420"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,12,0" Padding="10"
                Background="#E01A2230" CornerRadius="8"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Inventory"
                           Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" x:Name="InventoryHint"
                           Foreground="#FF9FB0BE" FontSize="11" TextWrapping="Wrap"
                           Text="Click an item to equip/unequip. Equipped items are highlighted."
                           Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="InventoryList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Class change panel -->
        <Border x:Name="ClassPanel"
                Width="320"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0182838" CornerRadius="10" Padding="20"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Choose Your Second Class"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="ClassHint" Foreground="#FF9FB0BE" FontSize="12"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <StackPanel x:Name="ClassOptions"/>
                <Button Content="Close" Height="28" Margin="0,12,0,0" Click="ClassClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Trade request prompt -->
        <Border x:Name="TradePrompt"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,80,0,0" Padding="18,12"
                Background="#F02A2438" CornerRadius="8"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TradePromptText" Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Accept" Width="80" Height="26" Margin="0,0,8,0"
                            Click="TradeAccept_Click"/>
                    <Button Content="Decline" Width="80" Height="26" Click="TradeDecline_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Trade window -->
        <Border x:Name="TradeWindow"
                Width="560" Height="460"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0141C28" CornerRadius="10" Padding="14"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="TradeTitle"
                           Foreground="White" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <!-- Footer buttons -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="TradeReadyButton" Content="Ready" Width="120" Height="32"
                            Margin="0,0,10,0" Click="TradeReady_Click"/>
                    <Button Content="Cancel" Width="120" Height="32" Click="TradeWindowCancel_Click"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Their offer (top), yours (middle), your bag (bottom) -->
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" x:Name="TheirOfferLabel"
                                   Foreground="#FFFFCC66" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Border DockPanel.Dock="Top" Height="110" Background="#40000000"
                                CornerRadius="4" Padding="4" Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TheirOfferList"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="Your offer"
                                   Foreground="#FF88DDAA" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Border Background="#40000000" CornerRadius="4" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="MyOfferList"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Your inventory (click to add)"
                                   Foreground="#FF9FB0BE" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Border Background="#40000000" CornerRadius="4" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TradeBagList"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Death overlay -->
        <Border x:Name="DeathOverlay"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#D0300A0A" CornerRadius="10" Padding="36,24"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="You died" Foreground="#FFFF8080" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <Button x:Name="RespawnButton" Content="Respawn" Height="34" Width="140"
                        Margin="0,18,0,0" FontSize="14" FontWeight="SemiBold"
                        Click="RespawnButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Login overlay -->
        <Border x:Name="LoginPanel"
                Width="340"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0182028" CornerRadius="10" Padding="24">
            <StackPanel>
                <TextBlock Text="Enter the World" Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <TextBlock Text="Character name" Foreground="#FFB9C4CC" Margin="0,0,0,4"/>
                <TextBox x:Name="NameInput" Height="28" MaxLength="16"
                         Background="#60000000" Foreground="White"
                         BorderBrush="#FF445566" CaretBrush="White"/>
                <TextBlock Text="Race" Foreground="#FFB9C4CC" Margin="0,12,0,4"/>
                <ComboBox x:Name="RaceCombo" Height="28"/>
                <TextBlock Text="Class" Foreground="#FFB9C4CC" Margin="0,12,0,4"/>
                <ComboBox x:Name="ClassCombo" Height="28"/>
                <Button x:Name="ConnectButton" Content="Connect &amp; Play" Height="34" Margin="0,20,0,0"
                        FontSize="14" FontWeight="SemiBold" Click="ConnectButton_Click"/>
                <TextBlock x:Name="LoginError" Foreground="#FFFF6B6B" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
