<Window x:Class="Game.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L2-like — Phase 3"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#FF101418">
    <Grid>

        <!-- World view -->
        <Canvas x:Name="WorldCanvas"
                Background="#FF15201A"
                ClipToBounds="True"
                MouseLeftButtonDown="WorldCanvas_MouseLeftButtonDown"/>

        <!-- HUD: status top-left -->
        <TextBlock x:Name="StatusText"
                   Margin="12,8,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Foreground="#FFB9C4CC" FontFamily="Consolas" FontSize="13"
                   Text="Not connected"/>

        <!-- Target frame (top center, L2-style) -->
        <Border x:Name="TargetFrame"
                Width="230"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,10,0,0" Padding="10,6"
                Background="#A0000000" CornerRadius="6"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TargetNameText"
                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <Border Background="#60000000" Height="9" Margin="0,5,0,0" CornerRadius="2">
                    <Rectangle x:Name="TargetHpFill"
                               Fill="#FFCC3333"
                               HorizontalAlignment="Left" Width="208"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Skill bar (bottom center) -->
        <StackPanel x:Name="SkillBar"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Visibility="Collapsed"/>

        <!-- Cast bar (above the skill bar) -->
        <Border x:Name="CastBar"
                Width="230" Height="18"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,58"
                Background="#90000000" CornerRadius="4"
                Visibility="Collapsed">
            <Grid>
                <Rectangle x:Name="CastFill"
                           Fill="#FF4488DD"
                           HorizontalAlignment="Left" Width="0" RadiusX="3" RadiusY="3"/>
                <TextBlock x:Name="CastText"
                           Foreground="White" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Chat: system panel on top, tabbed chats below -->
        <Border x:Name="ChatPanel"
                Width="460" Height="320"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="10" Padding="6"
                Background="#A0000000" CornerRadius="6"
                Visibility="Collapsed">
            <DockPanel>
                <TextBox x:Name="ChatInput"
                         DockPanel.Dock="Bottom"
                         Height="26" Margin="0,6,0,0"
                         Background="#60000000" Foreground="White"
                         BorderBrush="#FF445566" CaretBrush="White"
                         KeyDown="ChatInput_KeyDown"/>

                <!-- 1st row: system chat -->
                <Border DockPanel.Dock="Top" Height="62" Margin="0,0,0,4"
                        Background="#40000000" CornerRadius="4" Padding="4">
                    <ScrollViewer x:Name="SystemScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SystemList"/>
                    </ScrollViewer>
                </Border>

                <!-- 2nd row: tabbed chat -->
                <TabControl x:Name="ChatTabs"
                            Background="Transparent" BorderThickness="0"
                            Padding="2">
                    <TabItem Header="All">
                        <ScrollViewer x:Name="AllScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AllList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="World">
                        <ScrollViewer x:Name="WorldScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WorldList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Local">
                        <ScrollViewer x:Name="LocalScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LocalList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Whisper">
                        <DockPanel>
                            <ComboBox x:Name="WhisperNames"
                                      DockPanel.Dock="Top" Height="24" Margin="0,2,0,4"
                                      SelectionChanged="WhisperNames_SelectionChanged"/>
                            <ScrollViewer x:Name="WhisperScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="WhisperList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- Death overlay -->
        <Border x:Name="DeathOverlay"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#D0300A0A" CornerRadius="10" Padding="36,24"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="You died"
                           Foreground="#FFFF8080" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <Button x:Name="RespawnButton"
                        Content="Respawn"
                        Height="34" Width="140" Margin="0,18,0,0"
                        FontSize="14" FontWeight="SemiBold"
                        Click="RespawnButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Login overlay -->
        <Border x:Name="LoginPanel"
                Width="340"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0182028" CornerRadius="10" Padding="24">
            <StackPanel>
                <TextBlock Text="Enter the World"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <TextBlock Text="Character name" Foreground="#FFB9C4CC" Margin="0,0,0,4"/>
                <TextBox x:Name="NameInput" Height="28" MaxLength="16"
                         Background="#60000000" Foreground="White"
                         BorderBrush="#FF445566" CaretBrush="White"/>

                <TextBlock Text="Race" Foreground="#FFB9C4CC" Margin="0,12,0,4"/>
                <ComboBox x:Name="RaceCombo" Height="28"/>

                <TextBlock Text="Class" Foreground="#FFB9C4CC" Margin="0,12,0,4"/>
                <ComboBox x:Name="ClassCombo" Height="28"/>

                <Button x:Name="ConnectButton"
                        Content="Connect &amp; Play"
                        Height="34" Margin="0,20,0,0"
                        FontSize="14" FontWeight="SemiBold"
                        Click="ConnectButton_Click"/>

                <TextBlock x:Name="LoginError"
                           Foreground="#FFFF6B6B" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
