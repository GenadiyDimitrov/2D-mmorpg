<Window x:Class="Game.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L2-like — Phase 4"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#FF101418">
    <Grid>

        <Canvas x:Name="WorldCanvas"
                Background="#FF15201A"
                ClipToBounds="True"
                MouseLeftButtonDown="WorldCanvas_MouseLeftButtonDown"/>

        <Border x:Name="ClockPanel" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0" Padding="12,4" CornerRadius="6"
                Background="#60000000" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ClockText" Foreground="#FFE8E2C8"
                           FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                           Text="06:00 Day" HorizontalAlignment="Center"/>
                <TextBlock x:Name="MoveStateText" Foreground="#FFBFD0DA"
                           FontFamily="Consolas" FontSize="11"
                           Text="Running  (Z sit / X walk)" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8,0,0" Width="240">
            <TextBlock x:Name="StatusText" Foreground="#FFD8E0E6"
                       FontFamily="Consolas" FontSize="12" Text="Not connected" Margin="0,0,0,4"/>

            <Grid Margin="0,1,0,1">
                <Border Background="#50000000" Height="16" CornerRadius="3"/>
                <Rectangle x:Name="HpBarFill" Fill="#FFD24B4B" Height="16"
                           HorizontalAlignment="Left" Width="0" RadiusX="3" RadiusY="3"/>
                <TextBlock x:Name="HpBarText" Foreground="White" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,1,0,1">
                <Border Background="#50000000" Height="16" CornerRadius="3"/>
                <Rectangle x:Name="MpBarFill" Fill="#FF3F7FD8" Height="16"
                           HorizontalAlignment="Left" Width="0" RadiusX="3" RadiusY="3"/>
                <TextBlock x:Name="MpBarText" Foreground="White" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,1,0,1">
                <Border Background="#50000000" Height="14" CornerRadius="3"/>
                <Rectangle x:Name="ExpBarFill" Fill="#FFC9A227" Height="14"
                           HorizontalAlignment="Left" Width="0" RadiusX="3" RadiusY="3"/>
                <TextBlock x:Name="ExpBarText" Foreground="White" FontSize="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <ItemsControl x:Name="BuffBar" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!-- Top-right buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,12,0">
            <Button x:Name="SkillsButton" Content="Skills (K)" Width="80" Height="28"
                    Margin="0,0,6,0" Click="SkillsButton_Click" Visibility="Collapsed"/>
            <Button x:Name="StatsButton" Content="Stats (C)" Width="80" Height="28"
                    Margin="0,0,6,0" Click="StatsButton_Click" Visibility="Collapsed"/>
            <Button x:Name="DebugButton" Content="Debug" Width="64" Height="28"
                    Margin="0,0,6,0" Click="DebugButton_Click" Visibility="Collapsed"
                    Background="#FF553333" Foreground="White"/>
            <Button x:Name="InventoryButton" Content="Inventory (I)" Width="110" Height="28"
                    Margin="0,0,6,0" Click="InventoryButton_Click" Visibility="Collapsed"/>
            <Button x:Name="SettingsButton" Content="Settings" Width="80" Height="28"
                    Click="SettingsButton_Click" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Target frame -->
        <Border x:Name="TargetFrame"
                Width="240"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,10,0,0" Padding="10,6"
                Background="#A0000000" CornerRadius="6"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="TargetNameText"
                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="TargetClearButton" Content="✕"
                            Width="18" Height="18" Padding="0" FontSize="10"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Clear target (Esc)" Click="TargetClear_Click"/>
                </Grid>
                <Border Background="#60000000" Height="9" Margin="0,5,0,4" CornerRadius="2">
                    <Rectangle x:Name="TargetHpFill" Fill="#FFCC3333"
                               HorizontalAlignment="Left" Width="218"/>
                </Border>
                <Button x:Name="TradeButton" Content="Request Trade" Height="24"
                        Click="TradeButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Action bar: skills centered (2 rows of 6 squares), potions pinned right.
             Both live in reserved grid columns so a wide skill bar never slides
             under the potion squares. -->
        <Grid x:Name="ActionBarGrid"
              HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <UniformGrid x:Name="SkillBar" Grid.Column="1" Rows="2" Columns="12"
                         VerticalAlignment="Bottom" Visibility="Collapsed"/>
            <StackPanel x:Name="PotionBar" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,12,0" Visibility="Collapsed"/>
        </Grid>

        <Border x:Name="CastBar"
                Width="230" Height="18"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,118"
                Background="#90000000" CornerRadius="4"
                Visibility="Collapsed">
            <Grid>
                <Rectangle x:Name="CastFill" Fill="#FF4488DD"
                           HorizontalAlignment="Left" Width="0" RadiusX="3" RadiusY="3"/>
                <TextBlock x:Name="CastText" Foreground="White" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Chat show/hide toggle (bottom-left corner, under the chat panel) -->
        <Button x:Name="ChatToggle" Content="💬" Width="34" Height="28"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="10,0,0,10" FontSize="14" Padding="0"
                Click="ChatToggle_Click" Visibility="Collapsed"/>

        <!-- Chat -->
        <Border x:Name="ChatPanel"
                Width="460" Height="300"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="10,10,10,64" Padding="6"
                Background="#A0000000" CornerRadius="6"
                Visibility="Collapsed">
            <DockPanel>
                <TextBox x:Name="ChatInput" DockPanel.Dock="Bottom"
                         Height="26" Margin="0,6,0,0"
                         Background="#60000000" Foreground="White"
                         BorderBrush="#FF445566" CaretBrush="White"
                         KeyDown="ChatInput_KeyDown"/>
                <Border DockPanel.Dock="Top" Height="62" Margin="0,0,0,4"
                        Background="#40000000" CornerRadius="4" Padding="4">
                    <ScrollViewer x:Name="SystemScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SystemList"/>
                    </ScrollViewer>
                </Border>
                <TabControl x:Name="ChatTabs" Background="Transparent" BorderThickness="0"
                            Padding="2" TabStripPlacement="Bottom">
                    <TabItem Header="All">
                        <ScrollViewer x:Name="AllScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AllList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="World">
                        <ScrollViewer x:Name="WorldScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WorldList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Local">
                        <ScrollViewer x:Name="LocalScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LocalList"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Whisper">
                        <DockPanel>
                            <ComboBox x:Name="WhisperNames" DockPanel.Dock="Top" Height="24"
                                      Margin="0,2,0,4" SelectionChanged="WhisperNames_SelectionChanged"/>
                            <ScrollViewer x:Name="WhisperScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="WhisperList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- Inventory panel -->
        <Border x:Name="InventoryPanel"
                Width="300" Height="420"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,12,0" Padding="10"
                Background="#E01A2230" CornerRadius="8"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Inventory"
                           Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" x:Name="InventoryHint"
                           Foreground="#FF9FB0BE" FontSize="11" TextWrapping="Wrap"
                           Text="Click an item to equip/unequip. Equipped items are highlighted."
                           Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="InvTabGear" Content="Gear" Width="100" Height="26"
                            Click="InvTabGear_Click"/>
                    <Button x:Name="InvTabQuest" Content="Quest Items" Width="120" Height="26"
                            Margin="6,0,0,0" Click="InvTabQuest_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="InventoryList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Class change panel -->
        <Border x:Name="ClassPanel"
                Width="320"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0182838" CornerRadius="10" Padding="20"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Choose Your Second Class"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="ClassHint" Foreground="#FF9FB0BE" FontSize="12"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <StackPanel x:Name="ClassOptions"/>
                <Button Content="Close" Height="28" Margin="0,12,0,0" Click="ClassClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Settings menu -->
        <Border x:Name="SettingsPanel"
                Width="300"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0182838" CornerRadius="10" Padding="20"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Settings"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <Button Content="Character Selection" Height="34" Margin="0,0,0,8"
                        Click="SettingsCharSelect_Click"/>
                <Button Content="Exit Game" Height="34" Margin="0,0,0,8"
                        Click="SettingsExit_Click"/>
                <Button Content="Close" Height="28" Margin="0,8,0,0" Click="SettingsClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Trade request prompt -->
        <Border x:Name="TradePrompt"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,80,0,0" Padding="18,12"
                Background="#F02A2438" CornerRadius="8"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TradePromptText" Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Accept" Width="80" Height="26" Margin="0,0,8,0"
                            Click="TradeAccept_Click"/>
                    <Button Content="Decline" Width="80" Height="26" Click="TradeDecline_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Trade window -->
        <Border x:Name="TradeWindow"
                Width="560" Height="460"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0141C28" CornerRadius="10" Padding="14"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="TradeTitle"
                           Foreground="White" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <!-- Footer buttons -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="TradeReadyButton" Content="Ready" Width="120" Height="32"
                            Margin="0,0,10,0" Click="TradeReady_Click"/>
                    <Button Content="Cancel" Width="120" Height="32" Click="TradeWindowCancel_Click"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Their offer (top), yours (middle), your bag (bottom) -->
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" x:Name="TheirOfferLabel"
                                   Foreground="#FFFFCC66" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Border DockPanel.Dock="Top" Height="110" Background="#40000000"
                                CornerRadius="4" Padding="4" Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TheirOfferList"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="Your offer"
                                   Foreground="#FF88DDAA" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Border Background="#40000000" CornerRadius="4" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="MyOfferList"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Your inventory (click to add)"
                                   Foreground="#FF9FB0BE" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Border Background="#40000000" CornerRadius="4" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TradeBagList"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Stats window -->
        <Border x:Name="StatsPanel"
                Width="380" MaxHeight="520"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,300,0" Padding="14"
                Background="#E0182838" CornerRadius="8"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Character Stats" Foreground="White"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <Button DockPanel.Dock="Bottom" Content="Close" Height="26"
                        Margin="0,10,0,0" Click="StatsClose_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="StatsList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Selection box chooser (pick N of the offered items) -->
        <Border x:Name="SelectionPopup"
                Width="340" MaxHeight="460"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F01C2636" CornerRadius="10" Padding="16"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="SelectionTitle" DockPanel.Dock="Top" Foreground="White"
                           FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="SelectionSubtitle" DockPanel.Dock="Top" Foreground="#FF9FB0BE"
                           FontSize="11" Margin="0,0,0,8"/>
                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SelectionConfirm" Grid.Column="0" Content="Confirm" Height="28"
                            Margin="0,0,4,0" Click="SelectionConfirm_Click"/>
                    <Button Grid.Column="1" Content="Cancel" Height="28"
                            Margin="4,0,0,0" Click="SelectionCancel_Click"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SelectionList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Equip comparison popup -->
        <Border x:Name="EquipPopup"
                Width="320"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F01C2636" CornerRadius="10" Padding="18"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="EquipPopupTitle" Foreground="White"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="EquipPopupSubtitle" Foreground="#FF9FB0BE"
                           FontSize="11" Margin="0,0,0,10"/>
                <ItemsControl x:Name="EquipCompareList"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="EquipConfirmButton" Content="Equip" Width="90" Height="30"
                            Margin="0,0,8,0" Click="EquipConfirm_Click"/>
                    <Button Content="Close" Width="80" Height="30" Click="EquipPopupClose_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Death overlay -->
        <Border x:Name="DeathOverlay"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#D0300A0A" CornerRadius="10" Padding="36,24"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="You died" Foreground="#FFFF8080" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <Button x:Name="RespawnButton" Content="Respawn" Height="34" Width="140"
                        Margin="0,18,0,0" FontSize="14" FontWeight="SemiBold"
                        Click="RespawnButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Account login / register -->
        <Border x:Name="AccountPanel"
                Width="340"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0141C28" CornerRadius="10" Padding="24">
            <StackPanel>
                <TextBlock Text="L2-like" Foreground="White" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="AccountModeText" Text="Log in to your account"
                           Foreground="#FFB9C4CC" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <TextBlock Text="Username" Foreground="#FFB9C4CC" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameInput" Height="30" MaxLength="20"
                         Background="#60000000" Foreground="White"
                         BorderBrush="#FF445566" CaretBrush="White" VerticalContentAlignment="Center"/>

                <TextBlock Text="Password" Foreground="#FFB9C4CC" Margin="0,12,0,4"/>
                <PasswordBox x:Name="PasswordInput" Height="30" MaxLength="40"
                             Background="#60000000" Foreground="White"
                             BorderBrush="#FF445566" VerticalContentAlignment="Center"/>

                <Button x:Name="LoginActionButton" Content="Log In"
                        Height="34" Margin="0,18,0,0" FontWeight="SemiBold"
                        Click="LoginAction_Click"/>
                <Button x:Name="ToggleAuthButton" Content="Need an account? Register"
                        Height="26" Margin="0,8,0,0" Background="Transparent"
                        Foreground="#FF7FB0FF" BorderThickness="0"
                        Click="ToggleAuth_Click"/>

                <TextBlock x:Name="AccountError" Foreground="#FFFF6B6B" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Character selection -->
        <Border x:Name="CharacterSelectPanel"
                Width="420" MaxHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0141C28" CornerRadius="10" Padding="22"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Select Character"
                           Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <Button DockPanel.Dock="Bottom" x:Name="NewCharacterButton"
                        Content="Create New Character" Height="34" Margin="0,12,0,0"
                        FontWeight="SemiBold" Click="NewCharacter_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CharacterSlots"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Character creation (class tree) -->
        <Border x:Name="CreatePanel"
                Width="720" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E0141C28" CornerRadius="10" Padding="22"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Create Your Character"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Bottom: name + connect -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,14,0,0">
                    <TextBlock Text="Name:" Foreground="#FFB9C4CC" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="NameInput" Width="160" Height="28" MaxLength="16"
                             Background="#60000000" Foreground="White"
                             BorderBrush="#FF445566" CaretBrush="White" VerticalContentAlignment="Center"/>
                    <Button x:Name="ConnectButton" Content="Create Character"
                            Width="150" Height="30" Margin="12,0,0,0"
                            FontWeight="SemiBold" Click="ConnectButton_Click"
                            IsEnabled="False"/>
                    <Button x:Name="BackToSelectButton" Content="Back"
                            Width="70" Height="30" Margin="8,0,0,0"
                            Click="BackToSelect_Click"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: the tree of buttons -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel x:Name="CreationTree"/>
                    </ScrollViewer>

                    <!-- Right: description of the current selection -->
                    <Border Grid.Column="1" Background="#40000000" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="CreationTitle" Foreground="#FFFFD27F"
                                           FontSize="17" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="CreationBody" Foreground="#FFD8E0E6"
                                           FontSize="13" TextWrapping="Wrap"/>
                                <ItemsControl x:Name="CreationSkills" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <TextBlock x:Name="LoginError" DockPanel.Dock="Bottom"
                           Foreground="#FFFF6B6B" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <!-- Skills window -->
        <Border x:Name="SkillsPanel"
                Width="420" MaxHeight="470"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,70,0,0"
                Background="#E0182838" CornerRadius="8" Padding="14"
                Visibility="Collapsed">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Skills" Foreground="White"
                               FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="SkillPointsText" Foreground="#FFE8E2C8"
                               FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Text="SP: 0"/>
                </Grid>

                <!-- Tabs -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="TabLearned" Content="Learned" Width="120" Height="28"
                            Click="SkillTabLearned_Click"/>
                    <Button x:Name="TabLearn" Content="Skills to Learn" Width="140" Height="28"
                            Margin="6,0,0,0" Click="SkillTabLearn_Click"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Close" Height="26"
                        Margin="0,10,0,0" Click="SkillsClose_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SkillsList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Learn confirmation popup -->
        <Border x:Name="LearnPopup"
                Width="360"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F01C2636" CornerRadius="10" Padding="18"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="LearnTitle" Foreground="White" FontSize="16"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="LearnBody" Foreground="#FFB9C4CC" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="LearnCost" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LearnConfirm" Content="Learn" Width="90" Height="30"
                            Click="LearnConfirm_Click"/>
                    <Button Content="Cancel" Width="90" Height="30" Margin="8,0,0,0"
                            Click="LearnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Skill detail popup (click a skill in the Skills window) -->
        <Border x:Name="SkillDetailPopup" Width="360"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F01C2636" CornerRadius="10" Padding="18"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="SkillDetailTitle" Foreground="White" FontSize="16"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="SkillDetailBody" Foreground="#FFB9C4CC" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button Content="Close" Width="90" Height="30" HorizontalAlignment="Right"
                        Click="SkillDetailClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Enchant popup -->
        <Border x:Name="EnchantPopup"
                Width="360"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F01C2636" CornerRadius="10" Padding="18"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="EnchantTitle" Foreground="White" FontSize="16"
                           FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="EnchantInfo" Foreground="#FFB9C4CC" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Choose a scroll:" Foreground="#FF9FB0BE" FontSize="12" Margin="0,0,0,4"/>
                <ItemsControl x:Name="EnchantScrollList"/>
                <Button Content="Close" Height="28" Margin="0,12,0,0" Click="EnchantClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Attribute reroll popup -->
        <Border x:Name="RerollPopup"
                Width="380"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F01C2636" CornerRadius="10" Padding="18"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="RerollTitle" Foreground="White" FontSize="16"
                           FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="RerollInfo" Foreground="#FFB9C4CC" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Lock the attributes you want to keep:" Foreground="#FF9FB0BE"
                           FontSize="12" Margin="0,0,0,4"/>
                <ItemsControl x:Name="RerollAttrList" Margin="0,0,0,8"/>
                <TextBlock Text="Reroll with:" Foreground="#FF9FB0BE" FontSize="12" Margin="0,0,0,4"/>
                <ItemsControl x:Name="RerollScrollList"/>
                <Button Content="Close" Height="28" Margin="0,12,0,0" Click="RerollClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Debug menu -->
        <Border x:Name="DebugPanel"
                Width="280" MaxHeight="520"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,44,12,0" Padding="12"
                Background="#F0301A1A" CornerRadius="8"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DEBUG (test only)" Foreground="#FFFF9999"
                           FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="DebugTabEquip" Content="Equip" Width="78" Height="24"
                            Margin="0,0,4,0" Click="DebugTabEquip_Click"/>
                    <Button x:Name="DebugTabConsum" Content="Consumables" Width="92" Height="24"
                            Margin="0,0,4,0" Click="DebugTabConsum_Click"/>
                    <Button x:Name="DebugTabFunc" Content="Functions" Width="78" Height="24"
                            Click="DebugTabFunc_Click"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Close" Height="24"
                        Margin="0,8,0,0" Click="DebugClose_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DebugList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- NPC dialog window -->
        <Border x:Name="DialogPanel"
                Width="440" MaxHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F0162232" CornerRadius="10" Padding="16"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="DialogNpcName" DockPanel.Dock="Top" Foreground="Gold"
                           FontSize="17" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="DialogNpcRole" DockPanel.Dock="Top" Foreground="#FF9FB0BE"
                           FontSize="11" Margin="0,0,0,10"/>
                <Button DockPanel.Dock="Bottom" Content="Close" Height="26"
                        Margin="0,10,0,0" Click="DialogClose_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DialogContent"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Vendor shop window -->
        <Border x:Name="ShopPanel"
                Width="460" MaxHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F0162232" CornerRadius="10" Padding="16"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="ShopTitle" DockPanel.Dock="Top" Foreground="Gold"
                           FontSize="17" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="ShopGoldText" DockPanel.Dock="Top" Foreground="#FFE8E2C8"
                           FontSize="12" Margin="0,0,0,10"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="ShopTabBuy" Content="Buy" Width="110" Height="26"
                            Click="ShopTabBuy_Click"/>
                    <Button x:Name="ShopTabSell" Content="Sell" Width="110" Height="26"
                            Margin="6,0,0,0" Click="ShopTabSell_Click"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Close" Height="26"
                        Margin="0,10,0,0" Click="ShopClose_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShopList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Quest log panel -->
        <Border x:Name="QuestLogPanel"
                Width="360" MaxHeight="520"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                Background="#E0182838" CornerRadius="8" Padding="14"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Quest Log" Foreground="White"
                           FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                <Button DockPanel.Dock="Bottom" Content="Close" Height="24"
                        Margin="0,8,0,0" Click="QuestLogClose_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="QuestLogContent"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</Window>
