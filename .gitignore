bin/
obj/
.vs/
*.user

# SQLite database (runtime-only; recreated via EnsureCreated)
*.db
*.db-shm
*.db-wal

# Runtime-only settings files (machine-specific; not build content, not committed)
debug-config.json
client-settings.json

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Windows shortcuts
*.lnk

# Headless Unity build log (regenerated by every APK build)
unitybuild.log
unitycompile.log

# Unity Test Runner scratch files. Unity WRITES these during a headless build and DELETES them again
# afterwards, so they flip in and out of the working tree on every build and get swept into whatever
# commit happens next (they have landed in three so far). They are generated, never edited.
Game.Client.Unity/Assets/Resources/PerformanceTestRunInfo.json
Game.Client.Unity/Assets/Resources/PerformanceTestRunInfo.json.meta
Game.Client.Unity/Assets/Resources/PerformanceTestRunSettings.json
Game.Client.Unity/Assets/Resources/PerformanceTestRunSettings.json.meta

# Local build artifacts staged for the phone (APK + server publish). Large and regenerated.
builds/

# Google Drive sync temp copies (they appear mid-write, then vanish)
.tmp.driveupload/
.tmp.drivedownload/
