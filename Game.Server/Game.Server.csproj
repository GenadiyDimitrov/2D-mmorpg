<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Workstation GC, deliberately. Server GC reserves its heap regions up front — on the phone
         (Termux/proot) that is a 256 GiB reservation the process is not allowed to make, and CoreCLR
         dies before Main with "GC heap initialization failed 0x8007000E". This property is what puts
         "System.GC.Server": false into the published runtimeconfig.json, so a fresh unzip just runs
         instead of needing the file hand-edited after every deploy. A single-writer 10 tick/s loop
         has nothing to gain from Server GC anyway. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Shared\Game.Shared.csproj" />
  </ItemGroup>

  <!-- `BL-163` — the Spirit Helper's shelf travels with a PUBLISHED build, so a server operator has
       the file to edit on a box with no repo behind it. ⚠ The repo copy in docs/data/ is still the
       authority: NpcBuffShelf.Find() walks UP for it first and only falls back to this one, because a
       build-copied file that shadows the authored one is how an edit appears to do nothing (the same
       trap a stale bin/ copy of game.db already set once). The server logs which path it read. -->
  <ItemGroup>
    <Content Include="..\docs\data\npc_buff_shelf.csv" Link="data\npc_buff_shelf.csv"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
