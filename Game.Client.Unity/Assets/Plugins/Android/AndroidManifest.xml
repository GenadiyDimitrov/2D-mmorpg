<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The app talks to the game server over the network. Unity usually adds this itself once it sees
         networking code, but declaring it here means it can't go missing. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- android:usesCleartextTraffic="true" is what your question 4.2 was about: it goes as an ATTRIBUTE
         on <application>, not as its own element. Since Android 9 (API 28) plain HTTP is blocked by
         default, and our dev server is http://<pc-ip>:5238 — without this the phone fails to connect
         with a bare "cleartext not permitted" and nothing else to go on.
         DEV ONLY: put the server behind HTTPS for a real release and delete this attribute. -->
    <!-- android:appCategory="game" tells Android (and Samsung's Game Launcher / Game Booster) that this
         is a GAME, which is what unlocks the in-game touch-block / "Game tools" overlay, do-not-disturb
         while playing, etc. Purely a hint; safe on non-Samsung devices. Requires Android 8 (API 26)+. -->
    <application android:usesCleartextTraffic="true"
                 android:appCategory="game">
        <!--Used when Application Entry is set to Activity, otherwise remove this activity block-->
        <!-- 🔴 PRODUCTION: DELETE THIS WHOLE <activity> BLOCK BEFORE A STORE RELEASE.
             Our Application Entry is GameActivity (ProjectSettings androidApplicationEntry: 2), so this
             activity is merged in with android:enabled="false" — but it KEEPS its LAUNCHER intent-filter,
             and the phone shows a SECOND app icon. Deleting it is safe: nothing here targets
             UnityPlayerActivity.

             ✅ KEPT DELIBERATELY, AS A TEST FEATURE (2026-08-02, owner's explicit call). The second entry
             runs a genuinely INDEPENDENT client: he logged in as admin on one and test1 on the other,
             both connected, saw each other in the world, and formed a working party. That is how duo /
             party testing is done now — do not remove it without asking.

             ⚠ At store time, VERIFY ON THE DEVICE which mechanism actually produced the second icon.
             Two independent clients cannot come from this block alone (same package, one process,
             launchMode="singleTask"), so a Samsung profile-level clone (Dual Messenger / Secure Folder,
             separate UID + data dir) is likely also involved — and that one is a PHONE SETTING no
             manifest edit can remove. Check `adb shell pm list users` and `pm list packages --user <id>`
             with the phone attached before declaring it fixed. -->
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
                  android:theme="@style/UnityThemeSelector">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>
        <!--Used when Application Entry is set to GameActivity, otherwise remove this activity block-->
        <activity android:name="com.unity3d.player.UnityPlayerGameActivity"
                  android:theme="@style/BaseUnityGameActivityTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
            <meta-data android:name="android.app.lib_name" android:value="game" />
        </activity>
    </application>
</manifest>
